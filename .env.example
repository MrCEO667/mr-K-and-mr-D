# Copy to .env — gitignored, never committed.

# Telegram (@BotFather)
# CHAT_ID is the shared group, not a personal chat: negative, -100... prefix
# for supergroups. Run `python scripts/telegram_setup.py` to discover it and
# the operator user IDs below. Make the group a supergroup before you fill this
# in -- a basic group's ID changes on upgrade and delivery silently breaks.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API v3 — console.cloud.google.com
# NOTE: the predecessor project implemented YouTube fully and collected zero
# rows because this key was never provisioned. Assert on startup that it exists.
YOUTUBE_API_KEY=

# Reddit script app — reddit.com/prefs/apps
# Without these, the public JSON endpoints return 403.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nicheradar/0.1 by u/yourname

# Product Hunt — producthunt.com/v2/oauth/applications
# The app's API key and secret. The collector exchanges them for a token via
# the client_credentials grant, so there is no token to paste or renew.
# The redirect URI must be https; it is never used, the grant is app-only.
PRODUCTHUNT_CLIENT_ID=
PRODUCTHUNT_CLIENT_SECRET=
# Optional: a pre-issued developer token instead of the pair above.
PRODUCTHUNT_TOKEN=

# Ollama (local, no key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
