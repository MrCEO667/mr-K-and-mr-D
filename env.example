# Copy to .env — gitignored, never committed.

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API v3 — console.cloud.google.com
# NOTE: the predecessor project implemented YouTube fully and collected zero
# rows because this key was never provisioned. Assert on startup that it exists.
YOUTUBE_API_KEY=

# Reddit script app — reddit.com/prefs/apps
# Without these, the public JSON endpoints return 403.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nicheradar/0.1 by u/yourname

# Product Hunt — api.producthunt.com/v2/docs
PRODUCTHUNT_TOKEN=

# Ollama (local, no key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
